# SalesMesh Fabric testnet. Copy is generated as .env (gitignored) on first network_up.sh,
# with every *_PW value replaced by a random secret. Never commit .env.

# Pinned images
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
GOLANG_IMAGE=golang:1.27-alpine

CHANNEL_NAME=commissionchannel

# Fabric CA bootstrap admins (one CA per org)
CA_ADMIN_USER=ca-admin
CA_ORDERER_ADMIN_PW=changeme
CA_MERCHANT_ADMIN_PW=changeme
CA_AUDITOR_ADMIN_PW=changeme

# Enrollment secrets for registered identities
ORDERER_NODE_PW=changeme
ORDERER_ADMIN_PW=changeme
MERCHANT_PEER_PW=changeme
MERCHANT_ADMIN_PW=changeme
MERCHANT_GATEWAY_PW=changeme
AUDITOR_PEER_PW=changeme
AUDITOR_ADMIN_PW=changeme
AUDITOR_AUDITOR1_PW=changeme
