# One origin for the PWA and the API (the refresh cookie is SameSite=Strict, path /api/v1/auth), with an
# automatic Let's Encrypt certificate for PUBLIC_HOST (e.g. 203.0.113.10.sslip.io). Daraja calls back here.
# Every Caddy log line (errors from reverse_proxy included) goes through this filter: callback URIs carry
# MPESA_CALLBACK_TOKEN and headers carry tokens / cookies, so both are deleted before anything is written.
{
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	# Public readiness probe only; /health/details stays unreachable from outside.
	handle /api/v1/health/ready {
		rewrite * /health/ready
		reverse_proxy gateway:4000
	}

	handle /api/* {
		reverse_proxy gateway:4000
	}

	handle {
		reverse_proxy frontend:3000
	}

	# No access log (the gateway logs redacted paths); error logs are filtered by the global block above.
}
