# One origin for the PWA and the API (the refresh cookie is SameSite=Strict, path /api/v1/auth), with an
# automatic Let's Encrypt certificate for PUBLIC_HOST (e.g. 203.0.113.10.sslip.io). Daraja calls back here.
{$PUBLIC_HOST} {
	encode zstd gzip

	# Public readiness probe only; /health/details stays unreachable from outside.
	handle /api/v1/health/ready {
		rewrite * /health/ready
		reverse_proxy gateway:4000
	}

	handle /api/* {
		reverse_proxy gateway:4000
	}

	handle {
		reverse_proxy frontend:3000
	}

	# No access log on purpose: callback URIs carry MPESA_CALLBACK_TOKEN (the gateway logs redacted paths).
}
