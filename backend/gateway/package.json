{
  "name": "@salesmesh/gateway",
  "version": "1.0.0",
  "description": "SalesMesh-Ledger Upstream Ingestion Gateway & Resilience Bridge",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest --config jest.config.js --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:integration": "jest --config jest.config.js --runInBand tests/integration",
    "requeue": "node dist/scripts/requeue.js",
    "user:create": "node dist/scripts/user-create.js",
    "user:unlock": "node dist/scripts/user-unlock.js",
    "user:disable": "node dist/scripts/user-admin.js disable",
    "user:reset-pin": "node dist/scripts/user-admin.js reset-pin",
    "keys:generate": "node dist/scripts/keys-generate.js",
    "reconcile:import": "node dist/scripts/reconcile-import.js",
    "trust:adjust": "node dist/scripts/trust-adjust.js",
    "payout:cancel": "node dist/scripts/payout-cancel.js",
    "payout:resolve": "node dist/scripts/payout-resolve.js",
    "ufaa:prepare": "node dist/scripts/ufaa-prepare.js",
    "ufaa:report": "node dist/scripts/ufaa-report.js",
    "ufaa:remit": "node dist/scripts/ufaa-remit.js",
    "ledger:init": "node dist/scripts/ledger-init.js",
    "ledger:requeue": "node dist/scripts/ledger-requeue.js",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@hyperledger/fabric-gateway": "1.12.1",
    "@hyperledger/fabric-protos": "0.3.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "globals": "^15.15.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  }
}
