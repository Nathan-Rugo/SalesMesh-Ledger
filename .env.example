# System Environment
NODE_ENV=development
PORT=4000
# Graceful shutdown is forced to exit after this long
SHUTDOWN_TIMEOUT_MS=15000
FRONTEND_PORT=3000
ML_SERVICE_PORT=8001

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=salesmesh_user
DB_PASSWORD=salesmesh_secure_password
DB_NAME=salesmesh_db
# Main pool (workers, health, scripts) and the separately sized hot-path pool (callback intake).
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_HOT_POOL_MAX=10
# One overall deadline for Redis claim + intake insert; beyond it the gateway answers 503.
HOT_PATH_DEADLINE_MS=150
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis Configuration (Idempotency Buffer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_IDEMPOTENCY_TTL_MS=86400000
# Hot-path Redis command budget; slower answers fall through to Postgres (the dedup truth).
REDIS_COMMAND_TIMEOUT_MS=100

# Analytical ML Microservice
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=500
MODEL_VERSION=v1.0.0
# Raw-mode history sent to ml-engine (capped at ml-engine's MAX_HISTORY_ROWS=2000 / 512 KB body).
ML_MAX_HISTORY_ROWS=2000
ML_MAX_BODY_BYTES=500000

# Safaricom Daraja 3.0 API Sandbox
# STK Push initiation (POST /api/v1/payments/stk). When true, the gateway refuses to start without
# the Daraja credentials below (consumer key/secret, shortcode, passkey, https callback URL).
STK_ENABLED=true
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret
# BusinessShortCode (also used in the STK Password). For a till, the store/HO number.
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_PASSKEY=your_daraja_passkey
# Paybill (CustomerPayBillOnline) or BuyGoods (CustomerBuyGoodsOnline)
DARAJA_TRANSACTION_TYPE=Paybill
# PartyB: the Paybill number, or the till number for BuyGoods (defaults to the shortcode)
DARAJA_PARTY_B=
# TransactionDesc (at most 13 characters)
DARAJA_TRANSACTION_DESC=SalesMesh
# STK Push timeout; never retried automatically (a retry could prompt the customer twice)
DARAJA_TIMEOUT_MS=10000
DARAJA_OAUTH_TIMEOUT_MS=5000
# One overall budget per STK Push (OAuth + retry + push + token refresh + push). Same-key waiters
# and the stale-PENDING threshold (this + 10 s) are derived from it.
DARAJA_TOTAL_TIMEOUT_MS=25000
# Gateway-ahead-of-Safaricom clock skew tolerated when matching a callback to an UNKNOWN request
STK_CLOCK_SKEW_MS=60000
# Distinct Idempotency-Keys per agent per minute
STK_RATE_LIMIT_PER_MINUTE=5
# Secret path token Daraja must call back on (Daraja does not sign callbacks).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=replace_with_random_hex_token
# Paste the LITERAL token value at the end (dotenv does not expand ${...}); the gateway refuses to
# start with STK_ENABLED=true unless this URL ends with /api/v1/mpesa/callback/<MPESA_CALLBACK_TOKEN>.
DARAJA_CALLBACK_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/callback/replace_with_random_hex_token
# C2B validation URL (rejects unknown agent codes before money moves; never writes intake).
# (Registered with Daraja, not read by the gateway; again with the literal token.)
DARAJA_C2B_VALIDATION_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/c2b/validation/replace_with_random_hex_token
# Optional Safaricom source-IP allowlist (comma-separated). Behind a proxy also set TRUST_PROXY.
MPESA_ALLOWED_IPS=
# Behind a reverse proxy / TLS terminator, set the number of proxy hops (e.g. 1; prefer a hop count
# over "true"). The client IP it yields drives the Safaricom allowlist AND the login IP throttle /
# auth audit trail. See also PUBLIC_ORIGIN below.
TRUST_PROXY=

# PII keyed hashing (Kenya DPA 2019): payload and counterparty hashes are HMAC-SHA256 under this key.
# Required, >= 32 bytes; the gateway and its workers refuse to start without it.
# Encodings: "base64:...", "hex:...", or raw UTF-8. Generate with:
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation: docs/compliance/pii-hmac-key-rotation.md
PII_HMAC_KEY=replace_with_base64_random_32_bytes
PII_HMAC_KEY_ID=k1
PII_HMAC_KEY_PREVIOUS=
PII_HMAC_KEY_PREVIOUS_ID=

# Settlement worker (durable intake queue)
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_VISIBILITY_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=2000
WORKER_BACKOFF_MAX_MS=300000
WORKER_SWEEP_INTERVAL_MS=60000
SPOOL_DRAIN_BATCH=50
# Redis outage spool is capped (oldest trimmed, logged)
SPOOL_MAX_ITEMS=100000
UNRESOLVED_RETRY_WINDOW_MS=900000
UNRESOLVED_BASE_DELAY_MS=30000
UNRESOLVED_MAX_DELAY_MS=300000
# Placeholder flat commission, in basis points (1000 = 10 %)
COMMISSION_RATE_BPS=1000

# Re-score worker (self-healing fail-safe quarantines)
RESCORE_INTERVAL_MS=30000
RESCORE_BATCH_SIZE=10
RESCORE_LEASE_MS=300000
RESCORE_MAX_ATTEMPTS=20
RESCORE_BACKOFF_BASE_MS=60000
RESCORE_BACKOFF_MAX_MS=3600000

# Daraja reconciliation (spec gh-6-recon). Runbook: docs/operations/reconciliation.md
# STK Query sweep: overdue ACCEPTED STK requests (no callback after STK_TTL + grace) are asked about
# through the Daraja STK Push Query API. When true, startup requires the Daraja credentials above.
RECONCILE_ENABLED=false
RECONCILE_INTERVAL_MS=60000
RECONCILE_BATCH_SIZE=20
# Overdue = older than STK_TTL (180 s) + this grace
RECONCILE_GRACE_MS=600000
# Only requests newer than this are swept (7 d): the first deploy does not query all history
RECONCILE_MAX_AGE_MS=604800000
# STK Push Query rate limit per process (queries per second)
RECONCILE_QPS=1
RECONCILE_LEASE_MS=300000
# Queries per request before it becomes RECONCILE_EXHAUSTED
RECONCILE_MAX_ATTEMPTS=8
RECONCILE_BACKOFF_BASE_MS=120000
RECONCILE_BACKOFF_MAX_MS=21600000
# Statement import (npm run reconcile:import): the statement's Short Code must equal
# DARAJA_BUSINESS_SHORTCODE (or DARAJA_PARTY_B); its Account must equal this when set.
RECONCILE_EXPECTED_ACCOUNT=
# Details / Reason Type prefixes (comma-separated) that make a completed paid-in row a payment.
RECONCILE_CREDIT_TYPES=Pay Bill Online,Pay Bill from,Merchant Payment
# Above either cap a real import needs --confirm (amount in whole KES)
RECONCILE_CONFIRM_MAX_ROWS=50
RECONCILE_CONFIRM_MAX_AMOUNT=500000
# Original statements are copied to <dir>/<sha256>/ (contains customer data: restrict access)
RECONCILE_EVIDENCE_DIR=reconcile-evidence
# A known receipt's payment time may differ from the statement's Completion Time by at most this
RECONCILE_TIME_TOLERANCE_MS=600000

# Verified payout destinations (spec gh-11): an agent registers their login phone (PIN-confirmed)
# and it is verified once with a small Daraja B2C payment whose registered name must match the
# user's full name. A replacement waits 24 h (cancellable) before it becomes active.
# When true, startup requires the B2C settings below (the OAuth app is DARAJA_CONSUMER_KEY/SECRET).
PAYOUTS_ENABLED=false
# The verification payment, whole shillings (default 10: the B2C minimum may exceed KES 1)
PAYOUT_VERIFICATION_AMOUNT=10
DARAJA_B2C_SHORTCODE=600000
DARAJA_B2C_INITIATOR_NAME=testapi
# The initiator password encrypted OFFLINE with Safaricom's public certificate (base64). Never logged.
DARAJA_B2C_SECURITY_CREDENTIAL=
# Literal token values again (dotenv does not expand ${...}).
DARAJA_B2C_RESULT_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/b2c/result/replace_with_random_hex_token
DARAJA_B2C_TIMEOUT_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/b2c/timeout/replace_with_random_hex_token
# Agent-claimed payouts (part 2): the whole matured balance, oldest escrows first, paid gross by B2C
# to the ACTIVE destination after the agent accepts the Fuliza disclosure (PIN-confirmed).
# Whole shillings: a claim below the minimum is refused; above the maximum the rest stays claimable.
PAYOUT_MIN_AMOUNT=10
PAYOUT_MAX_AMOUNT=150000
# A payout with no B2C result after this long is checked by Transaction Status (backoff doubles),
# and after PAYOUT_STATUS_MAX_ATTEMPTS it is UNRESOLVED: settle it with `npm run payout:resolve`.
PAYOUT_STATUS_AFTER_MS=600000
PAYOUT_STATUS_MAX_ATTEMPTS=6
# The Fuliza disclosure version agents must accept (texts live in src/domain/payout.ts; never edit one, add a version)
PAYOUT_DISCLOSURE_VERSION=1
# Unclaimed balance reminders (SMS to the login phone): days since the oldest claimable commission
# matured, for stages 1, 2 and 3 (strictly increasing), each sent once per unclaimed cycle.
# Stored stages are ordinals (1, 2, 3): changing this list re-interprets reminders already sent.
PAYOUT_REMINDER_DAYS=7,30,90
# Reminders are sent only from the first hour to before the second, Africa/Nairobi time.
PAYOUT_REMINDER_HOURS=8,20
# UFAA return (Unclaimed Financial Assets Act, part 3b; npm run ufaa:prepare / ufaa:report / ufaa:remit):
# matured commission unclaimed this many days before the 30 June period end is dormant (the Act's
# unpaid wages rule is one year). Holder report CSVs are written to UFAA_REPORT_DIR (git-ignored;
# they hold names and phone numbers).
UFAA_DORMANCY_DAYS=365
UFAA_REPORT_DIR=ufaa-returns
# Optional SMS alerts through Africa's Talking (username + key, or none: alerts are then only logged).
# Username "sandbox" uses the sandbox API: messages show in https://simulator.africastalking.com.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered sender ID (live only; leave empty in the sandbox).
AFRICASTALKING_SENDER_ID=

# Risk-adaptive escrow hold and trust scores (spec gh-23). Invalid values refuse the start.
#   S_t    = (1 - p)^w * R_eff^(1-w)          p: calibrated XGBoost p when layer-2 adjudicated,
#                                             else 0.5 * TRUST_REVIEW_P * (s / TRUST_FAST_CLEAR_S)
#   T_hold = min(MAX, (MIN + (MAX - MIN) * (1 - S_t)^GAMMA) * max(1, m)^KAPPA), m = amount / 30-day median
# A model CLEAR with S_t <= TRUST_FREEZE_AT is QUARANTINED (default (1 - TRUST_REVIEW_P)^w ~ 0.6156).
TRUST_TX_WEIGHT=0.7
TRUST_HOLD_MIN_HOURS=1
TRUST_HOLD_MAX_HOURS=72
TRUST_HOLD_GAMMA=2
TRUST_AMOUNT_KAPPA=1
TRUST_FREEZE_AT=
# Mirrors of ml-engine's review_xgb_threshold / filter_isolation_threshold (ml-engine is not changed)
TRUST_REVIEW_P=0.5
TRUST_FAST_CLEAR_S=0.45
# Amount factor: agents with fewer than TRUST_MIN_HISTORY settled payments in TRUST_MEDIAN_DAYS use this (KES)
TRUST_REFERENCE_AMOUNT=1000
TRUST_MIN_HISTORY=5
TRUST_MEDIAN_DAYS=30
# Rating R (default 0.5): +BETA*(1-R) per matured clean hold / statement confirmation (at most
# TRUST_MAX_CREDITS_PER_DAY per agent per day), -PENALTY per security-hold event. Operator correction:
#   npm run trust:adjust -- --agent AG042 --delta 0.15 --reason "..." [--ref <id>]
TRUST_CREDIT_BETA=0.05
TRUST_PENALTY=0.15
TRUST_MAX_CREDITS_PER_DAY=10
# R_eff = min(R, cap) until >= HOLDS clean matured holds over >= DAYS days and >= VALUE KES
TRUST_NEW_AGENT_CAP=0.85
TRUST_MATURE_HOLDS=20
TRUST_MATURE_DAYS=7
TRUST_MATURE_VALUE=10000

# Canary Protocol Configuration
CANARY_PROBE_AMOUNT=1.00
CANARY_HOLD_THRESHOLD_HOURS=24

# Security & Session (spec gh-5): RS256 access tokens (15 min) + rotating refresh cookie (7 days).
# Asymmetric only: the gateway refuses to start without an RSA key of at least 2048 bits.
# Dev key pair, run in backend/gateway:
#   npm run build && npm run keys:generate -- --kid dev-1
# which writes keys/jwt-dev-1.key.pem (git-ignored). The file path is relative to backend/gateway.
# Give the PEM inline (JWT_PRIVATE_KEY, "\n" for newlines) or as a file path (JWT_PRIVATE_KEY_FILE).
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_FILE=keys/jwt-dev-1.key.pem
JWT_KEY_ID=dev-1
# Key rotation: the previous public key keeps tokens it signed valid until they expire.
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEY_FILE=
JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=salesmesh-gateway
JWT_AUDIENCE=salesmesh-api
# At most 900 (15 min); larger values are clamped.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# A refresh-token family ends this many days after login, however often it is refreshed.
REFRESH_FAMILY_MAX_DAYS=30
# Credentialed CORS allowlist (exact origins, comma-separated). Same-site deployment is required:
# the refresh cookie is SameSite=Strict, path /api/v1/auth. Refresh/logout also check Origin.
CORS_ORIGINS=http://localhost:3000
# The gateway's public origin behind a TLS-terminating proxy (compared exactly for the refresh /
# logout Origin check), e.g. https://pay.example.co.ke. In production set this or TRUST_PROXY.
PUBLIC_ORIGIN=
# Plain-HTTP local development only: drops the __Secure- prefix and the Secure flag (ignored in production).
AUTH_COOKIE_INSECURE_DEV=false
# PIN hashing cost: scrypt log2(N) (15 = 32 MiB); never below 14 outside tests.
AUTH_SCRYPT_LOG_N=15
# Login brute-force protection (Redis; fails closed with 503 when Redis is down).
AUTH_PHONE_MAX_FAILURES=5
AUTH_LOCKOUT_BASE_MS=60000
AUTH_LOCKOUT_MAX_MS=3600000
# 24 h failure cap per phone, then admin unlock: `npm run user:unlock -- --phone 07XXXXXXXX`
AUTH_DAILY_FAILURE_CAP=20
AUTH_IP_MAX_FAILURES=20
AUTH_DEVICE_MAX_FAILURES=5
AUTH_DEVICE_COOKIE_DAYS=90
AUTH_GLOBAL_FAILURE_ALARM_PER_MINUTE=100
# A failed login never answers faster than this (similar timing for known and unknown users)
AUTH_FAILURE_MIN_MS=250
# Retention: auth_events (raw client IPs) are purged after this many days; expired/revoked refresh
# tokens after 30 days (settlement worker housekeeping). See docs/compliance/data-retention.md.
AUTH_EVENTS_RETENTION_DAYS=90
# Optional machine credential for monitoring scrapes of /health/details (header X-Metrics-Token).
HEALTH_METRICS_TOKEN=