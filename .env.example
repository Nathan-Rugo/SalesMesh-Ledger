# System Environment
NODE_ENV=development
PORT=4000
# Graceful shutdown is forced to exit after this long
SHUTDOWN_TIMEOUT_MS=15000
FRONTEND_PORT=3000
ML_SERVICE_PORT=8001

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=salesmesh_user
DB_PASSWORD=salesmesh_secure_password
DB_NAME=salesmesh_db
# Main pool (workers, health, scripts) and the separately sized hot-path pool (callback intake).
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_HOT_POOL_MAX=10
# One overall deadline for Redis claim + intake insert; beyond it the gateway answers 503.
HOT_PATH_DEADLINE_MS=150
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis Configuration (Idempotency Buffer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_IDEMPOTENCY_TTL_MS=86400000
# Hot-path Redis command budget; slower answers fall through to Postgres (the dedup truth).
REDIS_COMMAND_TIMEOUT_MS=100

# Analytical ML Microservice
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=500
MODEL_VERSION=v1.0.0
# Raw-mode history sent to ml-engine (capped at ml-engine's MAX_HISTORY_ROWS=2000 / 512 KB body).
ML_MAX_HISTORY_ROWS=2000
ML_MAX_BODY_BYTES=500000

# Safaricom Daraja 3.0 API Sandbox
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_PASSKEY=your_daraja_passkey
# Secret path token Daraja must call back on (Daraja does not sign callbacks).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=replace_with_random_hex_token
DARAJA_CALLBACK_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/callback/${MPESA_CALLBACK_TOKEN}
# C2B validation URL (rejects unknown agent codes before money moves; never writes intake).
DARAJA_C2B_VALIDATION_URL=https://your-ngrok-or-domain.ngrok-free.app/api/v1/mpesa/c2b/validation/${MPESA_CALLBACK_TOKEN}
# Optional Safaricom source-IP allowlist (comma-separated). Behind a proxy also set TRUST_PROXY (e.g. 1).
MPESA_ALLOWED_IPS=
TRUST_PROXY=

# PII keyed hashing (Kenya DPA 2019): payload and counterparty hashes are HMAC-SHA256 under this key.
# Required, >= 32 bytes; the gateway and its workers refuse to start without it.
# Encodings: "base64:...", "hex:...", or raw UTF-8. Generate with:
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation: docs/compliance/pii-hmac-key-rotation.md
PII_HMAC_KEY=replace_with_base64_random_32_bytes
PII_HMAC_KEY_ID=k1
PII_HMAC_KEY_PREVIOUS=
PII_HMAC_KEY_PREVIOUS_ID=

# Settlement worker (durable intake queue)
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_VISIBILITY_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=2000
WORKER_BACKOFF_MAX_MS=300000
WORKER_SWEEP_INTERVAL_MS=60000
SPOOL_DRAIN_BATCH=50
# Redis outage spool is capped (oldest trimmed, logged)
SPOOL_MAX_ITEMS=100000
UNRESOLVED_RETRY_WINDOW_MS=900000
UNRESOLVED_BASE_DELAY_MS=30000
UNRESOLVED_MAX_DELAY_MS=300000
# Placeholder flat commission, in basis points (1000 = 10 %)
COMMISSION_RATE_BPS=1000

# Re-score worker (self-healing fail-safe quarantines)
RESCORE_INTERVAL_MS=30000
RESCORE_BATCH_SIZE=10
RESCORE_LEASE_MS=300000
RESCORE_MAX_ATTEMPTS=20
RESCORE_BACKOFF_BASE_MS=60000
RESCORE_BACKOFF_MAX_MS=3600000

# Canary Protocol Configuration
CANARY_PROBE_AMOUNT=1.00
CANARY_HOLD_THRESHOLD_HOURS=24

# Security & Session
JWT_SECRET=your_development_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d